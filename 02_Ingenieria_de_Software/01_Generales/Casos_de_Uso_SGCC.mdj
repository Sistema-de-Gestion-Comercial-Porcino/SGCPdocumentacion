				{
					"_type": "UMLUseCase",
					"_id": "AAAAAAGhh4N4SBzm8Vk=",
					"_parent": {
						"$ref": "AAAAAAGhh4N3yhp1nwQ="
					},
					"name": "CU10 · Gestionar pagos y cobranza",
					"documentation": "Actores: Ventas / cobranza, Propietario / administración. Precondición: Personal autorizado; pagos requieren dinero realmente recibido.. Acciones: Registrar seña, cobro o abono; Acordar crédito; Consultar y seguir deuda; Corregir registro de pago; Gestionar comprobante fiscal. Productos y servicios acordados/prestados separados. Deuda independiente de entrega. Facturación externa solo con integración habilitada y respuesta confirmada."
				},
				{
					"_type": "UMLAssociation",
