				{
					"_type": "UMLUseCase",
					"_id": "AAAAAAGhh4N4IRvuHW8=",
					"_parent": {
						"$ref": "AAAAAAGhh4N3yhp1nwQ="
					},
					"name": "CU06 · Gestionar pedidos",
					"documentation": "Actores: Ventas / cobranza, Comprador. Precondición: Autenticación; confirmación exige cotización aceptada.. Acciones: Confirmar pedido; Consultar pedidos; Gestionar cambio o incidencia; Cancelar pedido. Reservas y pagos se gestionan en sus módulos con referencia al pedido. Cancelar resuelve seña y reservas por acuerdo; no borra dinero."
				},
				{
					"_type": "UMLAssociation",
