					},
					"name": "Almacén",
					"documentation": "Casos directos: CU01, CU07, CU08, CU09, CU12."
				},
				{
					"_type": "UMLActor",
					"_id": "1VPdCiHWbvpxxhM=",
					"_parent": {
						"$ref": "56Rcy9u9G3FV/bo="
					},
					"name": "Responsable de entrega",
					"documentation": "Casos directos: CU01, CU07, CU11, CU12."
				},
				{
					"_type": "UMLUseCase",
					"_id": "N2Mb/r8LthpCkXM=",
					"_parent": {
						"$ref": "56Rcy9u9G3FV/bo="
					},
					"name": "CU01 · Gestionar acceso (Iniciar sesión · Registro · Recuperar acceso)",
					"documentation": "Actores directos: Administrador, Finanzas, Ventas, Comprador, Producción, Almacén, Responsable de entrega. Secciones: Iniciar sesión · Registro · Recuperar acceso. Cuenta: iniciar sesión, registrarse como comprador, recuperar y restablecer la clave, cerrar sesión."
				},
				{
					"_type": "UMLUseCase",
					"_id": "5bBMYTqIt0e4XuQ=",
					"_parent": {
						"$ref": "56Rcy9u9G3FV/bo="
					},
					"name": "CU13 · Administrar cuentas de nivel superior (Usuarios › cuentas de Propietario y Superadministrador)",
					"ownedElements": [
						{
							"_type": "UMLExtend",
							"_id": "pmrJ7ucTODZpGag=",
							"_parent": {
								"$ref": "5bBMYTqIt0e4XuQ="
							},
							"source": {
								"$ref": "5bBMYTqIt0e4XuQ="
							},
							"target": {
								"$ref": "fOgbbIYyTSo4AjI="
							}
						}
					],
					"documentation": "Actores directos: Superadministrador. Secciones: Usuarios › cuentas de Propietario y Superadministrador. Solo el Superadministrador modifica cuentas de Propietario o de otro Superadministrador. No se puede desactivar al último Superadministrador activo."
				},
				{
					"_type": "UMLUseCase",
					"_id": "fOgbbIYyTSo4AjI=",
					"_parent": {
						"$ref": "56Rcy9u9G3FV/bo="
					},
					"name": "CU02 · Administrar usuarios (Usuarios)",
					"documentation": "Actores directos: Administrador. Secciones: Usuarios. Usuarios: consultar, crear, editar, asignar roles de nivel inferior al propio, desactivar y habilitar. Nadie se autoeleva privilegios."
				},
				{
					"_type": "UMLUseCase",
					"_id": "r6k02v3FqegWxg8=",
					"_parent": {
						"$ref": "56Rcy9u9G3FV/bo="
					},
					"name": "CU14 · Delegar rol de Finanzas (Usuarios › rol FINANZAS)",
					"ownedElements": [
						{
							"_type": "UMLExtend",
							"_id": "3YedZTxxV6ilUD0=",
							"_parent": {
								"$ref": "r6k02v3FqegWxg8="
							},
							"source": {
								"$ref": "r6k02v3FqegWxg8="
							},
							"target": {
								"$ref": "fOgbbIYyTSo4AjI="
							}
						}
					],
					"documentation": "Actores directos: Propietario. Secciones: Usuarios › rol FINANZAS. Solo el Propietario (o el Superadministrador) asigna o retira el rol FINANZAS. El Administrador no puede."
				},
				{
					"_type": "UMLUseCase",
					"_id": "NLOrRv8BUHW94o8=",
					"_parent": {
						"$ref": "56Rcy9u9G3FV/bo="
					},
					"name": "CU03 · Gestionar clientes (Clientes)",
					"documentation": "Actores directos: Administrador, Ventas, Finanzas. Secciones: Clientes. Clientes: alta con tipo y número de documento únicos, edición, baja con regla de historial y pedidos del cliente."
				},
				{
					"_type": "UMLUseCase",
					"_id": "q4h3tLeklyn8WJE=",
					"_parent": {
						"$ref": "56Rcy9u9G3FV/bo="
					},
					"name": "CU07 · Gestionar productos (Productos · Clasificaciones)",
					"documentation": "Actores directos: Administrador, Ventas, Comprador, Producción, Almacén, Responsable de entrega, Finanzas. Secciones: Productos · Clasificaciones. Productos y clasificaciones del catálogo. El comprador y el personal operativo solo consultan."
				},
				{
					"_type": "UMLUseCase",
					"_id": "5eK1pv06ycyX67U=",
					"_parent": {
						"$ref": "56Rcy9u9G3FV/bo="
					},
					"name": "CU04 · Gestión de costos (Gestión de costos)",
					"documentation": "Actores directos: Propietario, Finanzas, Ventas. Secciones: Gestión de costos. Gestión de costos: costo de reposición y precio vigente por producto; Ventas consulta."
				},
				{
					"_type": "UMLUseCase",
					"_id": "SkFHbfZlSYeFn3Q=",
					"_parent": {
						"$ref": "56Rcy9u9G3FV/bo="
					},
					"name": "CU05 · Gestión de cotizaciones (Cotizaciones)",
					"documentation": "Actores directos: Propietario, Ventas, Comprador. Secciones: Cotizaciones. Cotizaciones: Ventas prepara y presenta; el comprador acepta o rechaza las suyas."
				},
				{
					"_type": "UMLUseCase",
					"_id": "ggGpeONY51Z1W4M=",
					"_parent": {
						"$ref": "56Rcy9u9G3FV/bo="
					},
					"name": "CU06 · Gestionar pedidos (Pedidos)",
					"documentation": "Actores directos: Propietario, Administrador, Ventas, Comprador, Finanzas. Secciones: Pedidos. Pedidos: confirmar desde una cotización aceptada, condición de pago, señas y cancelación con motivo. Administrador consulta los pedidos confirmados para preparar sus entregas."
				},
				{
					"_type": "UMLUseCase",
					"_id": "LmzMy3RXstaqWRQ=",
					"_parent": {
						"$ref": "56Rcy9u9G3FV/bo="
					},
					"name": "CU08 · Gestionar producción (Sanidad · Producción · Incidencias)",
					"documentation": "Actores directos: Administrador, Producción, Almacén. Secciones: Sanidad · Producción · Incidencias. Producción e inventario: control sanitario, faeneo/desposte y fabricación de derivados. Un rechazo sanitario es definitivo: el animal no admite otro control y conserva una sola incidencia; rechazar un animal apto exige el motivo («Pasó de apto a rechazado»). El consumo de una fabricación es irreversible: la orden que ya consumió no se anula."
				},
				{
					"_type": "UMLUseCase",
					"_id": "FvEmGc4h8ZyVuZg=",
					"_parent": {
						"$ref": "56Rcy9u9G3FV/bo="
					},
					"name": "CU09 · Gestionar inventario (Existencias · Pesajes y entradas · Pedidos por preparar · Control de frío)",
					"documentation": "Actores directos: Administrador, Producción, Almacén, Responsable de entrega. Secciones: Existencias · Pesajes y entradas · Pedidos por preparar · Control de frío. Producción e inventario: existencias, pesajes y entradas a almacén, control de frío. El control de frío se registra sobre un lote, una entrega o una cámara completa; rechazar una cámara exige la hora de inicio de la falla y deja en revisión solo los lotes y derivados expuestos desde esa hora. Existencias muestra el origen de cada lote y quién lo ingresó a qué cámara y cuándo."
				},
				{
					"_type": "UMLUseCase",
					"_id": "gbt0XkijOHFdJuc=",
					"_parent": {
						"$ref": "56Rcy9u9G3FV/bo="
					},
					"name": "CU10 · Gestionar pagos y cobranza (Saldos y pagos · Seguimiento)",
					"documentation": "Actores directos: Propietario, Finanzas, Ventas. Secciones: Saldos y pagos · Seguimiento. Cobranza: cargos, señas, pagos, crédito, saldos y comprobante fiscal."
				},
				{
					"_type": "UMLUseCase",
					"_id": "9m+GsM+eQ4jmtI8=",
					"_parent": {
						"$ref": "56Rcy9u9G3FV/bo="
					},
					"name": "CU11 · Gestionar transporte y entregas (Entregas · Rutas · Transportes · Conflictos de recepción)",
					"documentation": "Actores directos: Administrador, Ventas, Comprador, Responsable de entrega. Secciones: Entregas · Rutas · Transportes · Conflictos de recepción. Transporte y entregas: preparar y asignar entregas, rutas, transportes; captura sin conexión en Android; revisión de conflictos de recepción. A domicilio responde un repartidor (Responsable de entrega); en retiro en el local, Ventas o un repartidor que esté en el local. Ventas prepara, despacha y registra la recepción solo de sus retiros en el local."
				},
				{
					"_type": "UMLUseCase",
					"_id": "CKWa4/TearPmU+w=",
					"_parent": {
						"$ref": "56Rcy9u9G3FV/bo="
					},
					"name": "CU12 · Gestionar reportes (Reportes · Mis reportes · Constancia de entrega)",
					"documentation": "Actores directos: Administrador, Ventas, Comprador, Producción, Almacén, Responsable de entrega, Finanzas. Secciones: Reportes · Mis reportes · Constancia de entrega. Consultas: reportes en PDF/Excel según la matriz de cada rol; el comprador ve solo los suyos y descarga la constancia."
				},
				{
					"_type": "UMLUseCase",
					"_id": "QF58+ccYsavibus=",
					"_parent": {
						"$ref": "56Rcy9u9G3FV/bo="
					},
					"name": "CU15 · Consultar auditoría (Auditoría)",
					"ownedElements": [
						{
							"_type": "UMLExtend",
							"_id": "rZwqWAEHuf8SA+4=",
							"_parent": {
								"$ref": "QF58+ccYsavibus="
							},
							"source": {
								"$ref": "QF58+ccYsavibus="
							},
							"target": {
								"$ref": "CKWa4/TearPmU+w="
							}
						}
					],
					"documentation": "Actores directos: Propietario. Secciones: Auditoría. Consultas: registro de auditoría de solo lectura (permiso auditoria.consultar)."
				},
