				{
					"_type": "UMLUseCase",
					"_id": "AAAAAAGhh4N4QxzB+To=",
					"_parent": {
						"$ref": "AAAAAAGhh4N3yhp1nwQ="
					},
					"name": "CU09 · Gestionar inventario",
					"documentation": "Actores: Almacén. Precondición: Almacén autenticado; recepción o movimiento físico verificable.. Acciones: Consultar existencias y ubicaciones; Recibir productos; Reservar o liberar; Registrar salida o consumo; Corregir diferencia. Disponible = físico apto menos reservas activas. Cada movimiento y reserva tiene referencia única. La confirmación de producción no es una entrada."
				},
				{
					"_type": "UMLAssociation",
					"_id": "AAAAAAGhh4N4RxzXbEo=",
					"_parent": {
						"$ref": "AAAAAAGhh4N3yhp1nwQ="
					},
					"end1": {
