						{
							"_type": "UMLDependency",
							"_id": "AAAAAAGhrFSfJgtUzUs=",
							"_parent": {
								"$ref": "AAAAAAGhrFSe9AsM1kA="
							},
							"source": {
								"$ref": "AAAAAAGhrFSfHQsOhqo="
							},
							"target": {
