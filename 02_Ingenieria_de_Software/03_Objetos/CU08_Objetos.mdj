            {
              "_type": "UMLTextView",
              "_id": "AAAAAAGhh4Sjih5dLKQ=",
              "_parent": {
                "$ref": "AAAAAAGhh4SebxoGY3E="
              },
              "lineColor": "#303744",
              "fontColor": "#202735",
              "font": "Arial;18;0",
              "parentStyle": false,
              "showShadow": false,
              "left": 90,
              "top": 3200,
              "width": 2400,
              "height": 230,
              "text": "Datos ilustrativos; instantánea parcial. Vista parcial: OP-029 produce 6 kg de costilla y 4,5 kg de lomo, en lotes diferentes. OP-030 fabrica 3,2 kg de jamón elaborado. Cada resultado identifica producto, clasificación, lote y cantidad real. Almacén confirma pesajes; CU09 registra la entrada física una sola vez. Datos ilustrativos: no son rendimientos estándar."
            }
          ]
        },
