										{
											"_type": "UMLTextView",
											"_id": "AAAAAAGhh4Qb65y82WE=",
											"_parent": {
												"$ref": "AAAAAAGhh4Qb2pwqZ+s="
											},
											"lineColor": "#303744",
											"fontColor": "#202735",
											"font": "Arial;17;0",
											"parentStyle": false,
											"showShadow": false,
											"left": 80,
											"top": 2790,
											"width": 2450,
											"height": 500,
											"text": "Ramas mutuamente excluyentes: las guardas identifican la operación. Los mensajes al repositorio representan servicios de consulta/persistencia coordinados por el control. Selección de productos y acuerdos procede de la interfaz y del actor autorizado.\nCosto de referencia por producto y unidad; precio con vigencia. Margen estimado, sin costeo automático por animal. El histórico del pedido no se recalcula.\nAlternativas: Informar producto inexistente; Pedir corregir margen, fechas o unidades; conservar vigencia actual; Rechazar modificación retroactiva de pedidos confirmados"
										}
									],
									"sequenceNumbering": "custom"
								}
							],
							"documentation": "Colaboración del caso general con mensajes agrupados por operación. No ejecutar todas las ramas. Participantes de análisis; control no es tabla. Costo de referencia por producto y unidad; precio con vigencia. Margen estimado, sin costeo automático por animal. El histórico del pedido no se recalcula.",
							"messages": [
								{
									"_type": "UMLMessage",
