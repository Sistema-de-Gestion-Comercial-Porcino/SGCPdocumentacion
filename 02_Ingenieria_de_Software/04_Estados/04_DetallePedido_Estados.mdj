                    {
                      "_type": "UMLTextView",
                      "_id": "AAAAAAGhh4WaLM/nL74=",
                      "_parent": {
                        "$ref": "AAAAAAGhh4WYm89piDo="
                      },
                      "lineColor": "#303744",
                      "fontColor": "#202735",
                      "font": "Arial;17;0",
                      "parentStyle": false,
                      "showShadow": false,
                      "left": 90,
                      "top": 1430,
                      "width": 2070,
                      "height": 220,
                      "text": "Una previsión vinculada no crea reserva. Tras producción o recepción externa se comprueba stock físico apto y libre; si no alcanza, continúa EN_PREPARACION/PENDIENTE y se gestiona el faltante. La falta de plazo exige acuerdo; no se completa automáticamente."
                    }
                  ]
                }
              ],
              "documentation": "Una previsión vinculada no crea reserva. Tras producción o recepción externa se comprueba stock físico apto y libre; si no alcanza, continúa EN_PREPARACION/PENDIENTE y se gestiona el faltante. La falta de plazo exige acuerdo; no se completa automáticamente. Cada estado corresponde a un literal de EstadoDetalle. Las flechas llevan evento [guarda] / efecto cuando corresponde. Las transiciones sin etiqueta al final representan finalización del ciclo ya alcanzado. No confundir los estados de un objeto con actividades ejecutadas por varios actores.",
