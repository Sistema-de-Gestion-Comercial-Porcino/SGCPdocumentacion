                    {
                      "_type": "UMLTextView",
                      "_id": "AAAAAAGhh4YGXi0XQyw=",
                      "_parent": {
                        "$ref": "AAAAAAGhh4YEyyyDh5g="
                      },
                      "lineColor": "#303744",
                      "fontColor": "#202735",
                      "font": "Arial;17;0",
                      "parentStyle": false,
                      "showShadow": false,
                      "left": 90,
                      "top": 1430,
                      "width": 2070,
                      "height": 220,
                      "text": "Pago habilitado: contado cubierto o crédito aprobado, con servicio resuelto según acuerdo. Solo recepción conforme validada por servidor pasa a ENTREGADA; una observación validada queda OBSERVADA. No cambia deuda. Una captura Android PENDIENTE conserva el estado central previo. Retiro web requiere conexión."
                    }
                  ]
                }
              ],
              "documentation": "Pago habilitado: contado cubierto o crédito aprobado, con servicio resuelto según acuerdo. Solo recepción conforme validada por servidor pasa a ENTREGADA; una observación validada queda OBSERVADA. No cambia deuda. Una captura Android PENDIENTE conserva el estado central previo. Retiro web requiere conexión. Cada estado corresponde a un literal de EstadoEntrega. Las flechas llevan evento [guarda] / efecto cuando corresponde. Las transiciones sin etiqueta al final representan finalización del ciclo ya alcanzado. No confundir los estados de un objeto con actividades ejecutadas por varios actores.",
