                    },
                    {
                      "_type": "UMLTextView",
                      "_id": "AAAAAAGhh4WQc8T5XQU=",
                      "_parent": {
                        "$ref": "AAAAAAGhh4WO8sSC6EE="
                      },
                      "lineColor": "#303744",
                      "fontColor": "#202735",
                      "font": "Arial;17;0",
                      "parentStyle": false,
                      "showShadow": false,
                      "left": 90,
                      "top": 1430,
                      "width": 2070,
                      "height": 220,
                      "text": "La orden vigente puede cubrir varios pedidos. PROGRAMADA no significa stock reservado: solo pasa a PREPARADO cuando todos los detalles tienen cantidades reales aptas recibidas y reservas verificadas. Un faltante real exige nueva fecha, reemplazo o cancelación acordados; no habilita despacho."
                    }
                  ]
                }
              ],
              "documentation": "La orden vigente puede cubrir varios pedidos. PROGRAMADA no significa stock reservado: solo pasa a PREPARADO cuando todos los detalles tienen cantidades reales aptas recibidas y reservas verificadas. Un faltante real exige nueva fecha, reemplazo o cancelación acordados; no habilita despacho. Cada estado corresponde a un literal de EstadoPreparacion. Las flechas llevan evento [guarda] / efecto cuando corresponde. Las transiciones sin etiqueta al final representan finalización del ciclo ya alcanzado. No confundir los estados de un objeto con actividades ejecutadas por varios actores.",
